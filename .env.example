# AI generator (default: on). Set to false to sell the gallery as a white-label product.
NEXT_PUBLIC_ENABLE_AI_GENERATOR=true

# Optional branding overrides. If unset, values in lib/studio-config.ts are used.
# NEXT_PUBLIC_STUDIO_NAME=Ink & Iron Tattoo
# NEXT_PUBLIC_STUDIO_NAME_SHORT=Ink & Iron
# NEXT_PUBLIC_STUDIO_LOGO_URL=/studio-logo.png
# NEXT_PUBLIC_BOOKING_LINK=https://example.as.me/consult
# NEXT_PUBLIC_BOOKING_LABEL=Book a consultation
# NEXT_PUBLIC_STUDIO_ACCENT=#c084fc
# NEXT_PUBLIC_STUDIO_ACCENT_FOREGROUND=#000000
# NEXT_PUBLIC_STUDIO_HIGHLIGHT=#c084fc
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Contact link shown on expired studio previews
# NEXT_PUBLIC_SAMIRDEV_CONTACT=mailto:you@example.com?subject=Activate%20gallery%20preview
